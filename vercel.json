{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "public": "Iptv The smarters Pro",
  "routes": [
    {
      "src": "/products/iptv-encoders/?",
      "status": 301,
      "headers": { "Location": "/products/iptv-encoder/" }
    },
    {
      "src": "/products/hdmi-encoder-iptv/?",
      "status": 301,
      "headers": { "Location": "/products/hdmi-encoder-for-iptv/" }
    },
    {
      "src": "/products/4k-hdmi-iptv-encoder/?",
      "status": 301,
      "headers": { "Location": "/products/4k-iptv-encoder/" }
    },
    {
      "src": "/products/failed-to-authorize-iptv-smarters/?",
      "status": 301,
      "headers": { "Location": "/products/iptv-smarters-failed-to-authorize/" }
    },
    {
      "src": "/products/iptv-services/?",
      "status": 301,
      "headers": { "Location": "/iptv-services/" }
    },
    {
      "src": "/products/iptv-org-2/?",
      "status": 301,
      "headers": { "Location": "/products/iptv-org/" }
    },
    {
      "src": "/itemap.xml",
      "status": 301,
      "headers": { "Location": "/sitemap.xml" }
    },
    {
      "src": "/sitemap_index.xml",
      "status": 301,
      "headers": { "Location": "/sitemap.xml" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
